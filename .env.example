NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gates /setup, which creates the organisation and its super_admin account.
# Server-only — never prefix with NEXT_PUBLIC_. Open /setup?key=<this value>
# to run setup; leave it empty to disable setup entirely. Setup also closes
# for good once one organisation has completed it. Generate one with e.g.
# `openssl rand -hex 32`.
SETUP_KEY=

# Base URL used to build email links (invites, password resets). Optional —
# falls back to the request's own host — but set it explicitly in production
# so links are never built from a preview/internal hostname.
NEXT_PUBLIC_SITE_URL=

# Powers the Newsletter page only (Resend's REST API, no SDK). Invites and
# password resets don't need this — those go through Supabase's own SMTP
# settings, configured in the Supabase dashboard, not here. Requires a
# Resend account with the sending domain verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Hosted training video (Mux). Optional — leave all empty and video lessons
# use pasted links only. Server-only; never prefix with NEXT_PUBLIC_.
#   MUX_TOKEN_ID / MUX_TOKEN_SECRET: an API access token with Mux Video
#     read + write (Mux dashboard → Settings → Access Tokens).
#   MUX_SIGNING_KEY / MUX_PRIVATE_KEY: a URL signing key's id and its
#     base64-encoded private key (Settings → Signing Keys). Videos are
#     streamed with signed URLs, so both are required.
#   MUX_WEBHOOK_SECRET: signing secret of a webhook pointed at
#     https://<your-domain>/api/mux/webhook (Settings → Webhooks). Without it,
#     editors use "Check status" to pick up a finished upload.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

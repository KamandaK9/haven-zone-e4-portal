NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gates /setup, which creates the organisation and its super_admin account.
# Server-only — never prefix with NEXT_PUBLIC_. Open /setup?key=<this value>
# to run setup; leave it empty to disable setup entirely. Setup also closes
# for good once one organisation has completed it. Generate one with e.g.
# `openssl rand -hex 32`.
SETUP_KEY=

# Base URL used to build email links (invites, password resets). Optional —
# falls back to the request's own host — but set it explicitly in production
# so links are never built from a preview/internal hostname.
NEXT_PUBLIC_SITE_URL=

# Powers the Newsletter page only (Resend's REST API, no SDK). Invites and
# password resets don't need this — those go through Supabase's own SMTP
# settings, configured in the Supabase dashboard, not here. Requires a
# Resend account with the sending domain verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
